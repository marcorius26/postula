# Copia este fichero a .env.local y rellena con los datos de tu proyecto Supabase
# (Supabase > Project Settings > API). La anon/publishable key es pública por diseño;
# la protección real la dan las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
